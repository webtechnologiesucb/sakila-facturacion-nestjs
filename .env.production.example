# ════════════════════════════════════════════════════════════════════════════════
# Plantilla de PRODUCCIÓN - Sakila Facturación Electrónica
# ════════════════════════════════════════════════════════════════════════════════
# NO use valores de demostración. Genere secretos aleatorios, por ejemplo:
#   openssl rand -hex 32
# La aplicación falla al arrancar si detecta secretos demo o configuración insegura.
# El adaptador SIAT real permanece bloqueado hasta verificar contratos oficiales.
# ════════════════════════════════════════════════════════════════════════════════

POSTGRES_USER=sakila_prod
POSTGRES_PASSWORD=REEMPLACE_CON_PASSWORD_ALEATORIO
POSTGRES_DB=sakila_facturacion_prod

NODE_ENV=production
PORT=3000
BACKEND_PORT=3000

# Mínimo 32 caracteres, aleatorios y distintos entre sí.
JWT_ACCESS_SECRET=REEMPLACE_CON_AL_MENOS_32_CARACTERES_ALEATORIOS
JWT_REFRESH_SECRET=REEMPLACE_CON_OTRO_SECRETO_DE_32_CARACTERES

CORS_ORIGIN=https://facturacion.example.com
THROTTLE_TTL=60
THROTTLE_LIMIT=100
REQUEST_TIMEOUT_MS=30000

# En producción real, el seed de demostración debe permanecer desactivado.
RUN_SEED=false

# Mantenga simulated hasta completar la certificación y verificación oficial.
SIAT_MODE=simulated
SIGNATURE_PROVIDER=simulated
MOCK_SIAT_OUTCOME=success
SIAT_TIMEOUT_MS=8000
SIAT_RETRIES=2
SIAT_CONTRACTS_VERIFIED=false

# Solo si en el futuro se implementa y verifica el adaptador real:
# SIAT_BASE_URL=
# SIAT_CLIENT_ID=
# SIAT_CLIENT_SECRET=
# SIAT_CERTIFICATE_PATH=
# SIAT_PRIVATE_KEY_PATH=
# SIAT_ENVIRONMENT=production
