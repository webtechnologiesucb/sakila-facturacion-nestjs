# ════════════════════════════════════════════════════════════════════════════════
# Sakila Facturación Electrónica Boliviana - Entorno de DESARROLLO (DEMO)
# ════════════════════════════════════════════════════════════════════════════════
# Copie este archivo a .env y ajuste los valores.
# NUNCA suba secretos reales a control de versiones.
# Para producción use .env.production.example y valores aleatorios.
# ════════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=sakila
POSTGRES_PASSWORD=sakila-demo-pw-change-me
POSTGRES_DB=sakila_facturacion
# Puerto del host. Se usa 55432 para no chocar con un PostgreSQL local en 5432.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://sakila:sakila-demo-pw-change-me@localhost:55432/sakila_facturacion?schema=public

# ── Backend / API ───────────────────────────────────────────────────────────
PORT=3000
BACKEND_PORT=3000
NODE_ENV=development
# El prefijo global real es /api y Swagger se publica en /docs.
API_PREFIX=/api

# JWT: cambie estos valores fuera de la demo (mínimo 32 caracteres en producción).
JWT_ACCESS_SECRET=demo-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=demo-refresh-secret-change-me-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS: orígenes permitidos separados por coma. Nunca use "*" en producción.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Rate limiting (peticiones por ventana).
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Tiempo máximo de una solicitud HTTP (ms).
REQUEST_TIMEOUT_MS=30000

# Ejecutar seed idempotente al arrancar el contenedor.
RUN_SEED=true
# Contraseñas del seed SOLO para desarrollo. Cámbielas en producción.
SEED_ADMIN_PASSWORD=Admin123!Demo
SEED_BILLING_PASSWORD=Facturacion123!Demo
SEED_ANALYST_PASSWORD=Analista123!Demo
SEED_VIEWER_PASSWORD=Consulta123!Demo

# ── Proveedor tributario ────────────────────────────────────────────────────
# Valor por defecto: simulated (mock determinista). Producción real BLOQUEADA.
SIAT_MODE=simulated

# Resultado del mock: success | rejection | failure | timeout
# failure/timeout permiten probar reintentos y timeouts.
MOCK_SIAT_OUTCOME=success
SIAT_TIMEOUT_MS=8000
SIAT_RETRIES=2

# Firma: simulated | unconfigured.
SIGNATURE_PROVIDER=simulated

# Credenciales SIAT (solo si SIAT_MODE=real). Nunca incluirlas en la imagen.
SIAT_BASE_URL=
SIAT_CLIENT_ID=
SIAT_CLIENT_SECRET=
SIAT_CERTIFICATE_PATH=
SIAT_PRIVATE_KEY_PATH=
SIAT_ENVIRONMENT=sandbox
# El adaptador real se niega a operar si esto no es "true" con contratos verificados.
SIAT_CONTRACTS_VERIFIED=false

# ── Contribuyente emisor ficticio (prototipo) ───────────────────────────────
EMISOR_NIT=1234567890
EMISOR_RAZON_SOCIAL=Sakila Emisor Demo SRL
EMISOR_CODIGO_AMBIENTE=2
